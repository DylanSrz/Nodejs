# puerto en el que escucha la API
PORT= # 3000

# base de datos
DATABASE_HOST= # host de PostgreSQL; con Docker se sobrescribe a "db"
DATABASE_PORT= # puerto de PostgreSQL; 5432 por defecto
DATABASE_USER= # usuario de la base de datos
DATABASE_PASSWORD= # clave de la base de datos
DATABASE_NAME= # nombre de la base de datos

# clave para firmar los JWT: usa una cadena larga y aleatoria
JWT_SECRET=
