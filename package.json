{
  "name": "nodejs",
  "version": "1.0.0",
  "description": "Estructura de trabajo para Node.js ya completada y lista para desarrollar. Repositorio para practicar diferentes temas de desarrollo por ramas. Una rama un contexto diferente.",
  "main": "dist/app.js",
  "scripts": {
    "dev": "npx tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:types": "tsc --project tsconfig.test.json",
    "migrate": "tsx src/config/migrate-up.ts",
    "migrate:reverse": "tsx src/config/migrate-down.ts",
    "migrate:reset": "tsx src/config/migrate-reset.ts",
    "seed": "tsx src/config/seeders-up.ts",
    "seed:down": "tsx src/config/seeders-down.ts",
    "migrate:prod": "node dist/config/migrate-up.js",
    "seed:prod": "node dist/config/seeders-up.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DylanSrz/Nodejs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DylanSrz/Nodejs/issues"
  },
  "homepage": "https://github.com/DylanSrz/Nodejs#readme",
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "jest": "^30.5.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "zod": "^4.4.3"
  }
}
